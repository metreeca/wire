{
  "name": "@metreeca/wire-sparql",
  "version": "0.11.1",
  "description": "SPARQL 1.1 query language framework for @metreeca/wire storage connectors.",
  "keywords": [
    "typescript",
    "rdf",
    "iri",
    "sparql"
  ],
  "homepage": "https://metreeca.github.io/wire/",
  "bugs": {
    "url": "https://github.com/metreeca/wire/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metreeca/wire.git",
    "directory": "packages/wire-sparql"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@metreeca/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./builder": {
      "@metreeca/source": "./src/builder.ts",
      "default": "./dist/builder.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "rm dist docs node_modules",
    "build": "rm dist && tsc -p tsconfig.build.json",
    "check": "npx vitest --typecheck run"
  },
  "dependencies": {
    "@metreeca/core": "^0.12.1",
    "@metreeca/trio": "^0.1.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}
